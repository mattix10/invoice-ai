{
  "name": "invoiceai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "api:generate": "openapi-typescript http://127.0.0.1:8000/openapi.json --root-types --root-types-no-schema-prefix -o src/app/core/api/schema.ts && eslint --fix src/app/core/api/schema.ts && prettier --write src/app/core/api/schema.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && node scripts/check-angular-architecture.mjs && prettier --check \"src/**/*.{ts,html,scss}\"",
    "arch:test": "node --test scripts/check-angular-architecture.spec.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.10.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
