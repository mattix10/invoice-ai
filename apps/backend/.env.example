# Fictional credentials for local development only. Never use in production.
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=invoiceflow_local_only
POSTGRES_DB=invoiceflow
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow_local_only@localhost:5432/invoiceflow

# Set to demo for the local deterministic field suggestion parser.
AI_PROVIDER=disabled

# Live inference is local-only. Bind to 127.0.0.1 and do not use a reverse proxy.
# Generate a separate 256-bit secret with: python -c "import secrets; print(secrets.token_hex(32))"
# CLOUDFLARE_LOCAL_ENABLED=true
# CLOUDFLARE_LOCAL_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
